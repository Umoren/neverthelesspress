---
import { getCollection } from 'astro:content';

const issues = (await getCollection('issues')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const latestIssue = issues[0];
---

<footer class="site-footer">
  <div class="site-footer-copy">
    <div class="site-footer-mark">Nevertheless Press</div>
    <p>A gospel publication by Samuel Umoren. Built issue by issue, without losing the art.</p>
  </div>

  <div class="site-footer-links">
    <a href="/">Home</a>
    <a href="/archive">Archive</a>
    <a href="/about">About</a>
    {latestIssue && <a href={`/${latestIssue.slug}`}>Latest Issue</a>}
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.25rem 2rem 2.5rem;
    border-top: 1px solid rgba(245, 240, 232, 0.08);
    background: rgba(10, 9, 8, 0.94);
  }

  .site-footer-mark,
  .site-footer-links a {
    text-decoration: none;
  }

  .site-footer-mark {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    font-style: italic;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .site-footer-copy p {
    margin: 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--cream-mid);
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.85rem;
  }

  .site-footer-links a {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.66);
    border: 1px solid rgba(245, 240, 232, 0.12);
    padding: 0.55rem 0.8rem;
  }

  .site-footer-links a:hover {
    color: var(--cream);
    border-color: rgba(201, 168, 76, 0.32);
    background: rgba(201, 168, 76, 0.08);
  }

  @media (max-width: 720px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem 1.1rem 2.25rem;
    }

    .site-footer-links {
      justify-content: flex-start;
    }
  }
</style>
